<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_line_fields" model="ir.ui.view">
        <field name="name">account.move.form.inherit.line.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Aggiunge codice prodotto e serial number nella lista righe fattura -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="before">
                <field name="product_code" optional="show" string="Cod. Prodotto"/>
                <field name="serial_number" optional="show" string="Serial Number"/>
            </xpath>
        </field>
    </record>

</odoo>
