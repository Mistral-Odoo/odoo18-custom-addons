<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_line_fields" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.line.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Aggiunge codice prodotto e serial number nella lista righe ordine -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <field name="product_code" optional="show" string="Codice Prodotto"/>
                <field name="serial_number" optional="show" string="Serial Number"/>
            </xpath>
        </field>
    </record>

</odoo>
